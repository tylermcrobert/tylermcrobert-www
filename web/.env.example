# Required - The ID of your Sanity project
PUBLIC_SANITY_PROJECT_ID="xxxxxxxx"

# Required - The generated read token, used to fetch data on the server
SANITY_API_READ_TOKEN="your-read-token-abc123xyz"

# Required - Frontend production site url (without slash)
PUBLIC_SITE_URL="https://your-production-url.com"

#  Required - Used for stega and jumping into Sanity Studio
PUBLIC_SANITY_STUDIO_URL="https://your-studio-url.com"

#  Required - Sanity uses "production" by default
PUBLIC_SANITY_STUDIO_DATASET="production"

# Required — Preview cookie secret. Any value or auto-generated string will work
PREVIEW_COOKIE_SECRET="your-preview-secret-abc123xyz"
