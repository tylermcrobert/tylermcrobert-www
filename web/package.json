{
	"name": "svelte-sanity-starter",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"typegen": "cd ../studio/ && pnpm typegen",
		"merge-starter": "git fetch starter && git merge --squash starter/main"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.2",
		"@mux/playback-core": "^0.31.4",
		"@sanity/client": "^7.13.2",
		"@sanity/codegen": "^5.7.1",
		"@sveltejs/adapter-auto": "^6.1.1",
		"@sveltejs/kit": "^2.49.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.18",
		"@types/gtag.js": "^0.0.20",
		"@types/node": "^24.10.4",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^16.5.0",
		"groq": "^4.21.1",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.46.0",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.49.0",
		"vite": "^7.2.7"
	},
	"dependencies": {
		"@mux/mux-video": "^0.30.2",
		"@portabletext/svelte": "^3.0.1",
		"@sanity/sveltekit": "^1.0.4",
		"@tylermcrobert/svelte-sanity-image": "^1.3.0",
		"bad-words": "^4.0.0",
		"media-chrome": "^4.17.1"
	},
	"pnpm": {
		"overrides": {
			"cssstyle": "4.6.0"
		}
	}
}
